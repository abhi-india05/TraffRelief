# ==========================================
# TraffRelief Backend Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
SECRET_KEY=your_jwt_secret_key_here

# MongoDB Atlas Database URL
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/traffRelief?retryWrites=true&w=majority

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# BERT / DeBERTa Mental Health Classification Microservice URL
BERT_PREDICTION_URL=http://localhost:8000/predict

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EVALUATION_MODEL=gemini-2.5-flash-lite

# ==========================================
# Hybrid RAG & Longitudinal Evaluation Settings
# ==========================================

# Master toggle for RAG features (true | false)
RAG_ENABLED=true

# Semantic Vector Search toggle (requires MongoDB Atlas Vector Search index)
# Set to 'false' to run in Structured-Only mode (baseline + previous + recent history)
# Set to 'true' once the Atlas Vector Index 'audit_evidence_index' is created
RAG_VECTOR_SEARCH_ENABLED=false

# Gemini Embedding Model & Vector Dimensions
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# Atlas Vector Search Configuration
RAG_VECTOR_INDEX_NAME=audit_evidence_index
RAG_TOP_K_PER_DOMAIN=5
# Minimum raw cosine similarity [-1, 1]. In Atlas, vectorSearchScore = (1 + cosine) / 2.
# A raw cosine of 0.60 corresponds to an Atlas vectorSearchScore threshold of 0.80.
RAG_MIN_COSINE_SIMILARITY=0.60

# Structured History Retrieval Limits & Context Budgeting
RAG_RECENT_AUDIT_COUNT=5
RAG_MAX_EVIDENCE_PER_DOMAIN=5
RAG_MAX_CONTEXT_CHARS=36000

# ==========================================
# Data Privacy & API Tier Policy Enforcement
# ==========================================
# CRITICAL CLINICAL DATA GOVERNANCE:
# - 'paid': REQUIRED for production environments (NODE_ENV=production) and for ANY real patient trauma data.
#   Commercial API terms guarantee patient confidentiality (data is not logged or used for model training).
# - 'free': Strictly disallowed for real patient records. Permitted ONLY in local testing environments
#   when ALL records are explicitly marked dataClassification="synthetic" AND ALLOW_FREE_GEMINI_FOR_SYNTHETIC_DATA=true.
GEMINI_API_TIER=paid
ALLOW_FREE_GEMINI_FOR_SYNTHETIC_DATA=false
# Exact comma-separated list of database names permitted for free-tier testing with synthetic data
GEMINI_FREE_TIER_ALLOWED_DATABASES=traffrelief_synthetic,traffrelief_test

# ==========================================
# Gnani AI Voice Integration (Kannada Audio Interviews)
# ==========================================
# Master toggle for Gnani AI integration
GNANI_ENABLED=false
# Data privacy gate: Real patient data must NEVER be sent to external Gnani APIs
# Permitted ONLY for synthetic testing when set to true.
GNANI_ALLOW_REAL_DATA=false
# Gnani AI API Key
GNANI_API_KEY=your_gnani_api_key_here

# Gnani Prisma Speech-to-Text (STT) Settings
GNANI_PRISMA_MODEL=prisma-v3.0
GNANI_PRISMA_ENDPOINT=https://api.vachana.ai/stt/v3
GNANI_PRISMA_LANGUAGE=kn-IN
GNANI_PRISMA_MODE=codemix

# Gnani Timbre Text-to-Speech (TTS) Settings
GNANI_TIMBRE_MODEL=timbre-2.5
GNANI_TIMBRE_ENDPOINT=https://api.gnani.ai/v1/tts/inference
GNANI_TIMBRE_LANGUAGE=kn
GNANI_TIMBRE_VOICE=Kavin
GNANI_TIMBRE_SAMPLE_RATE=48000

# Node Environment
NODE_ENV=development
